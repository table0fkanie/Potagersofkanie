function pushData(){
    var kota=["Cianjur","Bandung ","Depok"]
    document.write(kota)
    document.write("<br>")
    kota.push("Pandeglang")
    document.write(kota)
}
function popData(){
    var kota=["Cianjur","Bandung ","Depok"]
    document.write(kota)
    document.write("<br>")
    kota.pop()
    document.write(kota)
}

function unshiftData(){
    var kota=["Cianjur","Bandung ","Depok"]
    document.write(kota)
    document.write("<br>")
    kota.unshift("Jakarta")
    document.write(kota)
}

function shiftData(){
    var kota=["Cianjur","Bandung ","Depok"]
    document.write(kota)
    document.write("<br>")
    kota.shift()
    document.write(kota)
}

function concatData(){
    var kota=["Cianjur","Bandung ","Depok"]
    var buah=["Durian","Rambutan","Anggur muscat"]
    document.write(kota)
    document.write(buah)
    var mix=kota.concat(buah)
    document.write("<br>")
    document.write(mix)
}

function indexData(){
    var kota=["Cianjur","Bandung ","Depok"]
    document.write(kota.indexOf("Bandung"))
}
function reverseData(){
    //0    1   2   
    var kota=["Cianjur","Bandung ","Depok"]
    document.write(kota)
     document.write("<br>")
    kota.reverse()
    document.write(kota)
}


